
<IfModule mod_rewrite.c>
    RewriteEngine On

    # --------------------------------------------------
    # 1. Handle Homepage at /, /index-temp, and /index-temp/
    # --------------------------------------------------
    RewriteRule ^$ index-temp.php [L]
    RewriteRule ^index-temp/?$ index-temp.php [L]

    # --------------------------------------------------
    # 2. Exclude cart API files from rewrites and redirects
    # --------------------------------------------------
    RewriteRule ^(add_to_cart|get_cart|update_cart_quantity|remove_from_cart|submit_review|get_product_details)\.php$ - [L]

    # --------------------------------------------------
    # 3. Handle /redeem.php → /redeem
    # --------------------------------------------------
    RewriteCond %{THE_REQUEST} \s/+redeem\.php(?:[\s?]) [NC]
    RewriteRule ^redeem\.php$ /redeem [R=301,L]

    # --------------------------------------------------
    # 4. Handle /redeem and /redeem/
    # --------------------------------------------------
    RewriteRule ^redeem/?$ redeem/index.php [L]

    # --------------------------------------------------
    # 5. Redirect direct .php URLs to clean URLs
    #    Preserve query strings; exclude admin, index-temp, and APIs
    # --------------------------------------------------
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.php(?:[\s?]) [NC]
    RewriteCond %1 !^index-temp$ [NC]
    RewriteCond %1 !^redeem$ [NC]
    RewriteCond %1 !^(add_to_cart|get_cart|update_cart_quantity|remove_from_cart|submit_review|get_product_details)$ [NC]
    RewriteCond %{REQUEST_URI} !^/admin/ [NC]
    RewriteRule ^(.+)\.php$ /%1 [R=301,L,NE]

    # --------------------------------------------------
    # 6. Do not rewrite existing physical files/directories
    # --------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --------------------------------------------------
    # 7. Clean URLs for existing PHP files (PRIORITY BEFORE ZONE ROUTES)
    #    Resolves: /logout → logout.php
    #              /checkout → checkout.php
    #              /terms → terms.php
    #              /orders/index → orders/index.php
    #              /orders/view-details → orders/view-details.php
    #              /orders/cancel-order → orders/cancel-order.php
    #              /products/index → products/index.php
    #              /admin/dashboard/index → admin/dashboard/index.php
    # --------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]

    # --------------------------------------------------
    # 8. Multi-zone routes (Actions inside zones)
    #    /{zone_slug}/{action} → zone/{action}.php?zone={zone_slug}
    # --------------------------------------------------
    RewriteCond %{REQUEST_URI} !^/(about|admin|assets|cart|checkout|components|config|contact|demo|error-pages|index-temp|join|login|login1|logout|order_confirmation|orders|products|public|redeem|scripts|signup|signup1|social-media|sql|terms|uploads|vendor|zone)(/|$) [NC]
    RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ zone/$2.php?zone=$1 [L,QSA]

    # --------------------------------------------------
    # 9. Multi-zone homepage
    #    /{zone_slug} → zone/index.php?zone={zone_slug}
    # --------------------------------------------------
    RewriteCond %{REQUEST_URI} !^/(about|admin|assets|cart|checkout|components|config|contact|demo|error-pages|index-temp|join|login|login1|logout|order_confirmation|orders|products|public|redeem|scripts|signup|signup1|social-media|sql|terms|uploads|vendor|zone)(/|$) [NC]
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ zone/index.php?zone=$1 [L,QSA]

    # --------------------------------------------------
    # 10. Fallback to public/ for unmatched requests
    # --------------------------------------------------
    RewriteCond %{REQUEST_URI} !^/(about|admin|assets|cart|checkout|components|config|contact|demo|error-pages|index-temp|join|login|login1|logout|order_confirmation|orders|products|public|redeem|scripts|signup|signup1|social-media|sql|terms|uploads|vendor|zone)(/|$) [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# --------------------------------------------------
# Security Headers
# --------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# --------------------------------------------------
# Block direct access to sensitive directories
# --------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteRule ^(config|scripts|sql|vendor)(/|$) - [F,L,NC]
</IfModule>