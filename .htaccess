
<IfModule mod_rewrite.c>
    RewriteEngine On

    # --------------------------------------------------
    # 1. Redirect direct access to index-temp.php → /
    # --------------------------------------------------
    RewriteCond %{THE_REQUEST} \s/+index-temp\.php(?:[\s?]) [NC]
    RewriteRule ^index-temp\.php$ / [R=301,L]

    # --------------------------------------------------
    # 2. Exclude cart API files from rewrites and redirects
    # --------------------------------------------------
    RewriteRule ^(add_to_cart|get_cart|update_cart_quantity|remove_from_cart|submit_review|get_product_details)\.php$ - [L]

    # --------------------------------------------------
    # 3. Handle /redeem.php → /redeem
    # --------------------------------------------------
    RewriteCond %{THE_REQUEST} \s/+redeem\.php(?:[\s?]) [NC]
    RewriteRule ^redeem\.php$ /redeem [R=301,L]

    # --------------------------------------------------
    # 4. Handle /redeem and /redeem/
    # --------------------------------------------------
    RewriteRule ^redeem/?$ redeem/index.php [L]

    # --------------------------------------------------
    # 5. Redirect direct .php URLs to clean URLs
    #    Preserve query strings; exclude admin and APIs
    # --------------------------------------------------
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.php(?:[\s?]) [NC]
    RewriteCond %1 !^index-temp$ [NC]
    RewriteCond %1 !^redeem$ [NC]
    RewriteCond %1 !^(add_to_cart|get_cart|update_cart_quantity|remove_from_cart|submit_review|get_product_details)$ [NC]
    RewriteCond %{REQUEST_URI} !^/admin/ [NC]
    RewriteRule ^(.+)\.php$ /%1 [R=301,L,NE]

    # --------------------------------------------------
    # 6. Load the temporary homepage at /
    # --------------------------------------------------
    RewriteRule ^$ index-temp.php [L]

    # --------------------------------------------------
    # 7. Do not rewrite existing physical files/directories
    # --------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --------------------------------------------------
    # 8. Multi-zone routes
    #    /{zone_slug}/{action}
    #    → zone/{action}.php?zone={zone_slug}
    # --------------------------------------------------
    RewriteCond %{REQUEST_URI} !^/(admin|assets|uploads|config|vendor|public|join|redeem|error-pages|cart|scripts|sql|zone)(/|$) [NC]
    RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ zone/$2.php?zone=$1 [L,QSA]

    # --------------------------------------------------
    # 9. Multi-zone homepage
    #    /{zone_slug}
    #    → zone/index.php?zone={zone_slug}
    # --------------------------------------------------
    RewriteCond %{REQUEST_URI} !^/(admin|assets|uploads|config|vendor|public|join|redeem|error-pages|cart|scripts|sql|zone)(/|$) [NC]
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ zone/index.php?zone=$1 [L,QSA]

    # --------------------------------------------------
    # 10. Clean URLs for existing PHP files
    #     Example: /admin/dashboard/index → index.php
    # --------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]

    # --------------------------------------------------
    # 11. Fallback to public/ for unmatched requests
    # --------------------------------------------------
    RewriteCond %{REQUEST_URI} !^/(admin|zone|public|join|assets|uploads|config|scripts|sql|vendor|redeem|cart|error-pages)(/|$) [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# --------------------------------------------------
# Security Headers
# --------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# --------------------------------------------------
# Block direct access to sensitive directories
# --------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteRule ^(config|scripts|sql|vendor)(/|$) - [F,L,NC]
</IfModule>